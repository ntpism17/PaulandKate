  <div>
    <svg viewBox="0 0 32 32"><path d="M16 4c5 4 7 8 7 12a7 7 0 0 1-14 0c0-4 2-8 7-12Z"/><path d="M16 9v18"/></svg>
    <b>{t('assure.2.t')}</b><span>{t('assure.2.d')}</span>
  </div>
  <div>
    <svg viewBox="0 0 32 32"><rect x="6" y="12" width="20" height="14"/><path d="M4 12h24v-3H4zM16 9v17M16 9c-2-4-7-4-6-1s6 1 6 1Zm0 0c2-4 7-4 6-1s-6 1-6 1Z"/></svg>

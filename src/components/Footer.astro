---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<footer class="footer">
  <div class="foot-cols">
    <div>
      <h4>{t('foot.know')}</h4>
      <ul><li><a href="#story">{t('foot.story')}</a></li><li><a href="#story">{t('foot.ingredients')}</a></li><li><a href="#how">{t('foot.how')}</a></li></ul>
    </div>
    <div>
      <h4>{t('foot.creations')}</h4>
      <ul><li><a href="#milky-meringue">{t('nav.meringues')}</a></li><li><a href="#chocolate-strawberry-cookies">{t('nav.cookies')}</a></li><li><a href="#brownie-crisps">{t('nav.brownie')}</a></li><li><a href="#almond-mosaic">{t('nav.almond')}</a></li></ul>
    </div>
    <div>
      <h4>{t('foot.services')}</h4>
      <ul><li><a href="#how">{t('foot.wholesale')}</a></li><li><a href="#how">{t('foot.gifting')}</a></li><li><a href="#enquire">{t('foot.contactUs')}</a></li></ul>
    </div>
    <div>
      <h4>{t('foot.contact')}</h4>
      <ul><li>[EMAIL ADDRESS]</li><li>LINE: [LINE ID]</li><li>[PHONE NUMBER]</li></ul>
    </div>
    <div>
      <h4>{t('foot.follow')}</h4>
      <!-- Replace # with your social profile links -->
      <div class="social">
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM21.9 8.2c-.1-1.6-.4-3-1.6-4.2S17.4 2.2 15.8 2.1C14.2 2 9.8 2 8.2 2.1c-1.6.1-3 .4-4.2 1.6S2.2 6.6 2.1 8.2C2 9.8 2 14.2 2.1 15.8c.1 1.6.4 3 1.6 4.2s2.6 1.5 4.2 1.6c1.6.1 6 .1 7.6 0 1.6-.1 3-.4 4.2-1.6s1.5-2.6 1.6-4.2c.1-1.6.1-6 0-7.6Zm-2.1 9.4a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.3.4s-4.1.1-5.3-.4a3 3 0 0 1-1.7-1.7c-.5-1.2-.4-4-.4-5.3s-.1-4.1.4-5.3a3 3 0 0 1 1.7-1.7c1.2-.5 4-.4 5.3-.4s4.1-.1 5.3.4a3 3 0 0 1 1.7 1.7c.5 1.2.4 4 .4 5.3s.1 4.1-.4 5.3Z"/></svg></a>
          <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v1.9H8v3.2h2.6V21H14v-9.3h2.6l.4-3.2h-3Z"/></svg></a>
          <a href="#" aria-label="LINE"><svg viewBox="0 0 24 24"><path d="M12 3C6.5 3 2 6.6 2 11.1c0 4 3.6 7.4 8.4 8 .3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s6-3.5 8.1-6C21.4 14.4 22 12.8 22 11.1 22 6.6 17.5 3 12 3ZM8.3 13.4H6.4a.5.5 0 0 1-.5-.5V9.1a.5.5 0 0 1 1 0v3.3h1.4a.5.5 0 0 1 0 1Zm2-.5a.5.5 0 0 1-1 0V9.1a.5.5 0 0 1 1 0v3.8Zm4.6 0a.5.5 0 0 1-.9.3l-1.9-2.6v2.3a.5.5 0 0 1-1 0V9.1a.5.5 0 0 1 .9-.3l1.9 2.6V9.1a.5.5 0 0 1 1 0v3.8Zm3-2.4a.5.5 0 0 1 0 1h-1.4v.9h1.4a.5.5 0 0 1 0 1h-1.9a.5.5 0 0 1-.5-.5V9.1a.5.5 0 0 1 .5-.5h1.9a.5.5 0 0 1 0 1h-1.4v.9h1.4Z"/></svg></a>
        </div>
    </div>
  </div>
  <div class="foot-bottom">
    <div class="wordmark"><b>Paul &amp; Kate</b><small>happy no guilty</small></div>
    <span>[ADDRESS] &nbsp;·&nbsp; &copy; {new Date().getFullYear()} Paul &amp; Kate</span>
  </div>
</footer>

<button class="to-top" id="toTop" aria-label={t('foot.toTop')}><svg viewBox="0 0 24 24"><path d="M5 15l7-7 7 7"/></svg></button>

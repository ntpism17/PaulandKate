---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const langs = Object.entries(languages) as [Lang, string][];
---
<div class="announce">
  <p>{t('bar.announce')}<a href="#enquire">{t('bar.cta')} →</a></p>
</div>

<header class="header" id="header">
  <div class="bar">
    <button class="menu-btn" id="menuBtn" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mainNav"><span></span><span></span></button>

    <nav class="main-nav" id="mainNav" aria-label="Primary" data-lenis-prevent>
      <a href="#creations" data-section>{t('nav.all')}</a>
      <a href="#milky-meringue">{t('nav.meringues')}</a>
      <a href="#chocolate-strawberry-cookies">{t('nav.cookies')}</a>
      <a href="#almond-mosaic">{t('nav.almond')}</a>
      <a href="#story" data-section>{t('nav.story')}</a>
      <a href="#how" data-section>{t('nav.wholesale')}</a>
      <div class="nav-lang">
        {langs.map(([code, label]) => code === lang
          ? <span>{label}</span>
          : <a href={getRelativeLocaleUrl(code, '')} hreflang={code}>{label}</a>)}
      </div>
    </nav>

    <a href="#top" class="wordmark brand" aria-label="Paul & Kate">
      <b>Paul &amp; Kate</b>
      <small>happy no guilty</small>
    </a>

    <div class="actions">
      <div class="lang-switch" aria-label="Language">
        {langs.map(([code, label]) => code === lang
          ? <span aria-current="true">{label}</span>
          : <a href={getRelativeLocaleUrl(code, '')} hreflang={code}>{label}</a>)}
      </div>
      <a href="#enquire" class="enquire-btn" aria-label={t('nav.enquiryList')}>
        {t('nav.enquire')}<span class="count" id="count">0</span>
      </a>
    </div>
  </div>
</header>
